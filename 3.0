-- ==========================================
local currentTrack = nil
local activeIndex = nil
local playbackSpeed = 1.0
local uiButtons = {}
-- Stop active animation cleanly
local function stopCurrentEmote()
	if currentTrack then
		currentTrack:Stop(0.2)
		currentTrack:Destroy()
		currentTrack = nil
	end
	activeIndex = nil
	-- Reset button visuals
	for idx, btnData in pairs(uiButtons) do
		TweenService:Create(btnData.Button, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(28, 31, 38)
		}):Play()
		TweenService:Create(btnData.Stroke, TweenInfo.new(0.2), {
			Color = Color3.fromRGB(0, 0, 0) -- Inner rim black
		}):Play()
		btnData.Status.Text = "PLAY"
		btnData.Status.TextColor3 = Color3.fromRGB(135, 145, 160)
	end
end
-- Play or toggle an emote by index
local function toggleEmote(index)
	if activeIndex == index then
		stopCurrentEmote()
		return
	end
	stopCurrentEmote()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	local emoteData = EMOTES[index]
	local anim = Instance.new("Animation")
	anim.AnimationId = emoteData.AnimationId
	local success, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if success and track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = emoteData.Looped
		track:Play(0.2)
		track:AdjustSpeed(playbackSpeed)
		currentTrack = track
		activeIndex = index
		-- Highlight active button
		local btnData = uiButtons[index]
		if btnData then
			TweenService:Create(btnData.Button, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(36, 46, 66)
			}):Play()
			TweenService:Create(btnData.Stroke, TweenInfo.new(0.2), {
				Color = Color3.fromRGB(88, 130, 255)
			}):Play()
			btnData.Status.Text = "ACTIVE"
			btnData.Status.TextColor3 = Color3.fromRGB(110, 155, 255)
		end
		track.Stopped:Connect(function()
			if activeIndex == index then
				stopCurrentEmote()
			end
		end)
	else
		warn("Failed to load animation ID: " .. tostring(emoteData.AnimationId))
	end
end
