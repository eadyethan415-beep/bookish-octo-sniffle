-- mobileButtons (LocalScript only)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Only show on mobile / touch devices
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "mobileButtons"
screenGui.ResetOnSpawn = false
screenGui.Enabled = isMobile          -- starts disabled on PC
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

----------------------------------------------------------------
-- Helper function to create a styled button
----------------------------------------------------------------
local function createButton(name, text, position)
	local button = Instance.new("TextButton")
	button.Name = name
	button.Position = position
	button.Size = UDim2.new(0.0408, 0, 0.0726, 0)
	button.BackgroundColor3 = Color3.new(1, 1, 1)
	button.BackgroundTransparency = 0.6
	button.BorderSizePixel = 0
	button.Rotation = 10
	button.Text = ""
	button.AutoButtonColor = true
	button.Parent = screenGui

	-- Gradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(141, 17, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
	}
	gradient.Rotation = 45
	gradient.Parent = button

	-- Outer stroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(176, 91, 252)
	stroke.Thickness = 1
	stroke.Parent = button

	-- Inner frame (for black outline + corner)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.Parent = button

	local innerStroke = Instance.new("UIStroke")
	innerStroke.Color = Color3.new(0, 0, 0)
	innerStroke.Thickness = 1
	innerStroke.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.08, 0)
	corner.Parent = frame

	-- Text
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(151, 74, 255)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/DenkOne.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
	label.Parent = button

	-- Press sound
	local sound = Instance.new("Sound")
	sound.Name = "Press"
	sound.SoundId = "rbxassetid://4601634016"
	sound.Volume = 1
	sound.Parent = button

	-- Play sound when clicked
	button.Activated:Connect(function()
		sound:Play()
	end)

	return button
end

----------------------------------------------------------------
-- Create the three buttons
----------------------------------------------------------------
local dashButton  = createButton("Dash",  "Dash",  UDim2.new(0.9219, 0, 0.4876, 0))
local getUpButton = createButton("GetUp", "Get Up", UDim2.new(0.9321, 0, 0.2917, 0))
local rButton     = createButton("R",     "R",     UDim2.new(0.9366, 0, 0.1139, 0))

print("[mobileButtons] GUI created")
