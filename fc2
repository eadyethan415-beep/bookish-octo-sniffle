-- Logic
----------------------------------------------------------------
local character = player.Character or player.CharacterAdded:Wait()
local camera = workspace.CurrentCamera

local barTweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local promptTweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local flashTweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local toggle = false
local prevMeter = 0
local funState = 1
local newMeter = 0

local remotes = ReplicatedStorage:FindFirstChild("Remotes")
local changeFunSpeed = remotes and remotes:FindFirstChild("ChangeFunSpeed")
local showPromptRemote = remotes and remotes:FindFirstChild("ShowPrompt")

local function showPromptText(text)
	promptLabel.Visible = true
	promptLabel.Text = text
	toggle = true

	TweenService:Create(promptLabel, promptTweenInfo, {TextTransparency = 0}):Play()
	TweenService:Create(promptLabel, promptTweenInfo, {TextStrokeTransparency = 0}):Play()
	TweenService:Create(promptImg, promptTweenInfo, {ImageTransparency = 0.6}):Play()
end

local function hidePromptText()
	toggle = false
	TweenService:Create(promptLabel, promptTweenInfo, {TextTransparency = 1}):Play()
	TweenService:Create(promptLabel, promptTweenInfo, {TextStrokeTransparency = 1}):Play()
	TweenService:Create(promptImg, promptTweenInfo, {ImageTransparency = 1}):Play()
	task.delay(0.45, function()
		promptLabel.Visible = false
	end)
end

local function theFunny(doFlash)
	hidePromptText()

	local originalFOV = camera.FieldOfView
	camera.FieldOfView = originalFOV + 20
	TweenService:Create(camera, promptTweenInfo, {FieldOfView = originalFOV}):Play()

	heartbeat:Play()

	if doFlash then
		white.Visible = true
		white.ImageTransparency = 0
		local t = TweenService:Create(white, flashTweenInfo, {ImageTransparency = 1})
		t:Play()
		t.Completed:Wait()
		white.Visible = false
	end
end

local function onRelease()
	if not toggle then return end

	if newMeter >= 1 then
		theFunny(true)
		task.delay(3, function() theFunny(true) end)
	else
		theFunny(false)
	end

	if changeFunSpeed then
		changeFunSpeed:FireServer(funState)
	end

	if funState == 4 then
		funState = 1
	end
end

-- Bar update
character:GetAttributeChangedSignal("funMeter"):Connect(function()
	newMeter = character:GetAttribute("funMeter") or 0

	TweenService:Create(bar, barTweenInfo, {
		Size = UDim2.new(1, 0, newMeter, 0)
	}):Play()

	if character:GetAttribute("doing") then
		local prevR = math.round(prevMeter * 100)
		if newMeter >= 1 and prevR == 98 then
			showPromptText("R - RELEASE")
			funState += 1
		elseif newMeter >= 0.6 and prevR == 60 then
			showPromptText("R - Faster")
			funState += 1
		elseif newMeter >= 0.26 and prevR == 26 then
			showPromptText("R - Faster")
			funState += 1
		end
	else
		hidePromptText()
	end

	funState = math.clamp(funState, 1, 4)
	prevMeter = newMeter
end)

character:GetAttributeChangedSignal("doing"):Connect(function()
	if not character:GetAttribute("doing") then
		hidePromptText()
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.R then
		onRelease()
	end
end)

